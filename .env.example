# PostgreSQL. Requerida en Render y en desarrollo con la base de datos local.
DATABASE_URL=postgresql://user:password@host:5432/inmortal_studios

# URL pública del API cuando el frontend está en Cloudflare Pages.
# Déjala vacía para el preview same-origin de Replit.
VITE_API_URL=

# Clerk (Replit lo provisiona automáticamente en este proyecto).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Discord bot -> API. Nunca expongas estas variables en Vite/frontend.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_API_KEY=

# IDs de Clerk autorizados como administradores, separados por comas.
ADMIN_USER_IDS=

# Opcional para sesiones auxiliares y futuras tareas de servidor.
SESSION_SECRET=
LOG_LEVEL=info
